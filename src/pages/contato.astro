---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contato — Fale conosco" description="Entre em contato com a equipe do Mundo Curioso Hoje. Formulário com Netlify Forms, resposta em até 2 dias úteis.">
  <section class="section">
    <div class="container" style="max-width:760px">
      <nav class="breadcrumb"><a href="/">Início</a> › Contato</nav>
      <h1 style="font-size:34px;letter-spacing:-.03em;margin:6px 0 10px">Fale conosco</h1>
      <p style="color:var(--cinza-600)">Dúvidas, correções ou sugestões de pauta? Escreva para nós. Respondemos em até 2 dias úteis. <strong>Não solicitamos senha, NIS ou dados bancários.</strong></p>

      <!-- Netlify Forms: data-netlify + honeypot -->
      <form name="contato" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/contato?sucesso=1" style="display:grid;gap:16px;margin-top:18px;background:var(--cinza-50);border:1px solid var(--cinza-200);padding:20px;border-radius:14px">
        <input type="hidden" name="form-name" value="contato" />
        <p style="display:none"><label>Não preencha: <input name="bot-field" /></label></p>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
          <label>Nome
            <input type="text" name="nome" required placeholder="Seu nome completo" />
          </label>
          <label>E-mail
            <input type="email" name="email" required placeholder="seu@email.com" />
          </label>
        </div>
        <label>Assunto
          <input type="text" name="assunto" required placeholder="Ex: Dúvida sobre uma curiosidade de ciência" />
        </label>
        <label>Mensagem
          <textarea name="mensagem" rows="6" required placeholder="Escreva sua mensagem com detalhes..."></textarea>
        </label>
        <label style="display:flex;gap:8px;align-items:start;font-weight:400;font-size:13px;color:var(--cinza-600)">
          <input type="checkbox" required style="width:auto;margin-top:4px" />
          Concordo com a <a href="/privacidade">Política de Privacidade</a> e o tratamento dos dados para resposta ao contato (LGPD).
        </label>
        <button type="submit" class="btn" style="justify-self:start">Enviar mensagem</button>
        <p style="font-size:12px;color:var(--cinza-600);margin:0">Este formulário usa Netlify Forms. Ao enviar, você concorda com o processamento via Netlify (EUA) conforme nossa política.</p>
      </form>

      <div style="margin-top:18px;font-size:14px;color:var(--cinza-600)">
        <strong>Outros canais:</strong> E-mail editorial: <a href="mailto:contato@mundocuriosohoje.com.br">contato@mundocuriosohoje.com.br</a> • Tempo médio de resposta: 48h
      </div>
    </div>
  </section>
</BaseLayout>
