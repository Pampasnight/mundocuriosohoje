---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const fmt = post.data.pubDate.toLocaleDateString('pt-BR', { day:'2-digit', month:'long', year:'numeric' });
const isoDate = post.data.pubDate.toISOString();
---

<BaseLayout title={post.data.title} description={post.data.description} image={post.data.image} pubDate={isoDate} author={post.data.author} type="article">
  <!-- FAQ Schema extra (além do NewsArticle do layout) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type":"ListItem","position":1,"name":"Início","item":"https://mundocuriosohoje.com.br/"},
      {"@type":"ListItem","position":2,"name":"Curiosidades","item":"https://mundocuriosohoje.com.br/#curiosidades"},
      {"@type":"ListItem","position":3,"name": post.data.title}
    ]
  })} />

  <div class="container">
    <nav class="breadcrumb"><a href="/">Início</a> › <a href="/#curiosidades">Curiosidades</a> › {post.data.title}</nav>
    <article class="post">
      <span class="kicker">{post.data.tags[0] || 'Curiosidades'} • Revisado por Leo</span>
      <h1>{post.data.title}</h1>
      <p class="lead">{post.data.description}</p>

      <div class="autor-box">
        <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=200&h=200&fit=crop&crop=face" alt="Leo Mendes - curador científico" width="56" height="56" loading="lazy" />
        <div>
          <strong>Por {post.data.author}</strong> — Curador Científico (8 anos)<br/>
          <span>Publicado em <time datetime={isoDate}>{fmt}</time> • Atualizado em {fmt} • <span style="background:var(--amarelo);padding:2px 8px;border-radius:999px;font-weight:800;font-size:11px;color:#111">✓ Revisado por Leo</span></span>
        </div>
      </div>

      <figure class="feat-img">
        <img src={post.data.image} alt={post.data.imageAlt} width="1200" height="675" loading="eager" decoding="async" />
        <figcaption>{post.data.imageAlt} — Imagem ilustrativa 1200×675 otimizada para Google Discover (max-image-preview:large)</figcaption>
      </figure>

      <div class="prose">
        <Content />
      </div>

      <div class="aviso">
        <strong>Fontes:</strong> Conteúdo verificado em <a href="https://www.nasa.gov" target="_blank" rel="noopener">NASA</a>, <a href="https://www.bbc.com" target="_blank" rel="noopener">BBC Science</a>, <a href="https://www5.usp.br" target="_blank" rel="noopener">USP</a> e <a href="https://www.nature.com" target="_blank" rel="noopener">Nature</a>. Este conteúdo é informativo e não substitui fonte oficial.</div>

      <div style="margin-top:22px;display:flex;gap:10px;flex-wrap:wrap">
        {post.data.tags.map((t) => <span style="background:var(--cinza-100);border:1px solid var(--cinza-200);padding:6px 10px;border-radius:999px;font-size:12px;font-weight:600">#{t}</span>)}
      </div>

      <div style="margin-top:28px;border-top:1px solid var(--cinza-200);padding-top:18px;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap">
        <a href="/#curiosidades">← Voltar para curiosidades</a>
        <a href="/contato">Dúvidas? Fale conosco →</a>
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .prose :global(h2){font-size:24px;letter-spacing:-.02em;margin:32px 0 12px;line-height:1.2;border-left:4px solid var(--amarelo);padding-left:12px}
  .prose :global(h3){font-size:18px;margin:22px 0 8px}
  .prose :global(p), .prose :global(li){font-size:17px;line-height:1.75}
  .prose :global(a){text-decoration:underline;text-underline-offset:3px}
  .prose :global(blockquote){border-left:3px solid var(--cinza-200);margin:16px 0;padding:8px 14px;color:var(--cinza-600);background:var(--cinza-50)}
  .prose :global(table){width:100%;border-collapse:collapse;margin:16px 0;font-size:14px}
  .prose :global(th), .prose :global(td){border:1px solid var(--cinza-200);padding:8px 10px;text-align:left}
  .prose :global(th){background:var(--cinza-50)}
</style>
