---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="Curiosidades e Ciência — Fatos que você vai querer contar" description="Curiosidades de ciência, espaço, corpo humano e história explicadas com fontes NASA, USP e BBC. Imagens 1200×675 e leitura de 3 minutos para Google Discover.">
  <section class="hero">
    <div class="container">
      <span class="kicker">Atualizado hoje — Fontes NASA, USP e BBC</span>
      <h1>Curiosidades que cabem numa conversa</h1>
      <p>Fatos de ciência, espaço e história contados em 3 minutos, com imagem 1200×675, fontes linkadas e selo “Revisado por Leo”. Descubra o porquê por trás do óbvio.</p>
      <div class="discover-note" style="margin-top:14px">💡 <strong>Discover-friendly:</strong> títulos com gap de curiosidade, imagens grandes e Core Web Vitals verde (Astro estático).</div>
    </div>
  </section>

  <section class="section" id="curiosidades">
    <div class="container">
      <div style="display:flex;justify-content:space-between;align-items:end;gap:16px;flex-wrap:wrap;margin-bottom:14px">
        <h2 style="margin:0;font-size:22px;letter-spacing:-.02em">Últimas curiosidades</h2>
        <a href="/sobre" style="font-weight:700;font-size:14px">Revisado por Leo Mendes →</a>
      </div>

      {posts.length === 0 ? (
        <p style="padding:24px;background:#f8fafc;border:1px dashed #cbd5e1;border-radius:12px">Em breve: curiosidades verificadas com fontes primárias.</p>
      ) : (
        <div class="grid">
          {posts.map((post) => (
            <a href={`/blog/${post.slug}`} class="card" style="text-decoration:none;color:inherit">
              <div class="card-img">
                <img src={post.data.image} alt={post.data.imageAlt} width="1200" height="675" loading="eager" decoding="async" />
                <span class="badge">{post.data.tags[0] || 'Curiosidades'}</span>
              </div>
              <div class="card-body">
                <div class="card-meta">
                  <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('pt-BR', { day:'2-digit', month:'short', year:'numeric'})}</time>
                  <span>•</span><span>{post.data.author}</span>
                </div>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
                <span style="font-weight:700;font-size:13px;color:var(--azul)">Ler curiosidade →</span>
              </div>
            </a>
          ))}
        </div>
      )}

      <div class="aviso" style="margin-top:20px">
        <strong>Nota editorial:</strong> Conteúdo informativo sobre ciência pop. Fontes primárias citadas em cada post: <a href="https://www.nasa.gov" target="_blank" rel="noopener">NASA</a>, <a href="https://www.bbc.com" target="_blank" rel="noopener">BBC</a>, <a href="https://www5.usp.br" target="_blank" rel="noopener">USP</a> e <a href="https://www.nature.com" target="_blank" rel="noopener">Nature</a>.
      </div>
    </div>
  </section>
</BaseLayout>
