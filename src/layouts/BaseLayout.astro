---
interface Props {
  title: string;
  description: string;
  image?: string;
  pubDate?: string;
  author?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}
const {
  title,
  description,
  image = 'https://mundocuriosohoje.com.br/og-default-1200x675.jpg',
  pubDate,
  author = 'Leo Mendes',
  type = 'website',
  noindex = false
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteName = 'Mundo Curioso Hoje';
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <title>{title} | {siteName}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  {!noindex && <meta name="robots" content="index, follow, max-image-preview:large" />}
  <meta name="google-site-verification" content="2j-KKBCjcEaqmzkUV9OfoqytHI1e3BJgxE_IX2x0hHk" />

  <!-- Open Graph / Discover 1200px -->
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={image} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="675" />
  <meta property="og:locale" content="pt_BR" />
  {pubDate && <meta property="article:published_time" content={pubDate} />}
  {author && <meta property="article:author" content={author} />}

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />

  <!-- Theme / Icons -->
  <meta name="theme-color" content="#0e4a7b" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <!-- Preconnect performance -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://www.googletagmanager.com" />

  <!-- GA4 Placeholder - substitua G-XXXXXXXXXX pelo seu ID -->
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-XXXXXXXXXX');
  </script>

  <!-- AdSense Placeholder - substitua ca-pub-XXXXXXXXXXXXXXX -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXX" crossorigin="anonymous"></script>

  <!-- Schema Organization + NewsArticle (quando type=article) -->
  <script type="application/ld+json" set:html={JSON.stringify(type === 'article' ? {
    "@context": "https://schema.org",
    "@type": "NewsArticle",
    "headline": title,
    "description": description,
    "image": [image],
    "datePublished": pubDate || new Date().toISOString(),
    "dateModified": pubDate || new Date().toISOString(),
    "author": { "@type": "Person", "name": author, "url": "https://mundocuriosohoje.com.br/sobre" },
    "publisher": {
      "@type": "Organization",
      "name": siteName,
      "logo": { "@type": "ImageObject", "url": "https://mundocuriosohoje.com.br/logo-600x60.png", "width": 600, "height": 60 }
    },
    "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalURL.toString() },
    "inLanguage": "pt-BR"
  } : {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": siteName,
    "url": "https://mundocuriosohoje.com.br",
    "logo": "https://mundocuriosohoje.com.br/logo-600x60.png",
    "sameAs": []
  })} />

  <style is:global>
    :root{
      --azul:#0e4a7b; --azul-esc:#0a355a; --amarelo:#ffb703; --cinza-50:#f8fafc; --cinza-100:#f1f5f9;
      --cinza-200:#e2e8f0; --cinza-600:#475569; --cinza-800:#1e293b; --verde:#0a7a42; --radius:14px;
      --max:1120px;
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;color:var(--cinza-800);background:#fff;line-height:1.6;-webkit-font-smoothing:antialiased}
    a{color:var(--azul);text-decoration:none}
    a:hover{color:var(--azul-esc);text-decoration:underline}
    img{max-width:100%;height:auto;display:block}
    .container{max-width:var(--max);margin:0 auto;padding:0 20px}
    /* Header */
    .topbar{background:var(--azul);color:#fff;font-size:13px}
    .topbar .container{display:flex;justify-content:space-between;align-items:center;padding:6px 20px;gap:12px}
    .topbar a{color:#fff;text-decoration:underline;text-underline-offset:3px}
    header.site{position:sticky;top:0;z-index:40;background:#fff;border-bottom:1px solid var(--cinza-200)}
    .header-inner{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px 20px}
    .brand{display:flex;align-items:center;gap:10px;font-weight:800;letter-spacing:-.02em;color:var(--azul);font-size:22px}
    .brand span{color:var(--cinza-800)}
    .brand small{display:block;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--cinza-600);font-weight:600;margin-top:-4px}
    nav.main{display:flex;gap:18px;align-items:center;flex-wrap:wrap}
    nav.main a{font-weight:600;font-size:14px;color:var(--cinza-800);padding:6px 0;border-bottom:2px solid transparent}
    nav.main a[aria-current="page"]{color:var(--azul);border-color:var(--amarelo)}
    .btn{display:inline-flex;align-items:center;justify-content:center;padding:10px 16px;border-radius:999px;font-weight:700;font-size:14px;border:1px solid var(--azul);background:var(--azul);color:#fff}
    .btn:hover{background:var(--azul-esc);color:#fff;text-decoration:none}
    .btn--ghost{background:#fff;color:var(--azul)}
    /* Hero / Cards */
    .hero{background:var(--cinza-50);border-bottom:1px solid var(--cinza-200);padding:28px 0}
    .hero h1{font-size:clamp(28px,4vw,38px);line-height:1.05;letter-spacing:-.03em;margin:0 0 10px}
    .hero p{color:var(--cinza-600);font-size:clamp(16px,2vw,18px);max-width:720px;margin:0}
    .grid{display:grid;grid-template-columns:repeat(12,1fr);gap:20px}
    .card{grid-column:span 12;background:#fff;border:1px solid var(--cinza-200);border-radius:var(--radius);overflow:hidden;display:flex;flex-direction:column;transition:box-shadow .2s,transform .2s}
    .card:hover{box-shadow:0 10px 30px rgba(2,12,27,.08);transform:translateY(-2px)}
    .card-img{aspect-ratio:16/9;background:var(--cinza-100);position:relative;overflow:hidden}
    .card-img img{width:100%;height:100%;object-fit:cover}
    .badge{position:absolute;top:12px;left:12px;background:var(--amarelo);color:#1a1a1a;font-weight:800;font-size:11px;letter-spacing:.06em;text-transform:uppercase;padding:6px 10px;border-radius:999px}
    .card-body{padding:16px 16px 18px;display:flex;flex-direction:column;gap:10px;flex:1}
    .card-meta{font-size:12px;color:var(--cinza-600);display:flex;gap:10px;align-items:center;flex-wrap:wrap}
    .card-meta time{font-weight:600}
    .card h3{font-size:18px;line-height:1.25;margin:0;letter-spacing:-.02em}
    .card p{font-size:14px;color:var(--cinza-600);margin:0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    @media(min-width:640px){ .card{grid-column:span 6} }
    @media(min-width:980px){ .card{grid-column:span 4} }
    /* Article */
    .breadcrumb{font-size:13px;color:var(--cinza-600);margin:18px 0}
    .breadcrumb a{color:var(--cinza-600)}
    article.post{max-width:760px;margin:0 auto}
    article.post h1{font-size:clamp(30px,5vw,42px);line-height:1.05;letter-spacing:-.03em;margin:10px 0 12px}
    article.post .lead{font-size:19px;color:var(--cinza-600);line-height:1.5;margin:0 0 18px}
    article.post h2{font-size:24px;letter-spacing:-.02em;margin:32px 0 12px;line-height:1.2;border-left:4px solid var(--amarelo);padding-left:12px}
    article.post h3{font-size:18px;margin:22px 0 8px}
    article.post p, article.post li{font-size:17px;line-height:1.75}
    article.post ul, article.post ol{padding-left:20px}
    .autor-box{display:flex;gap:14px;align-items:center;background:var(--cinza-50);border:1px solid var(--cinza-200);border-radius:12px;padding:14px;margin:18px 0}
    .autor-box img{width:56px;height:56px;border-radius:50%;object-fit:cover}
    .autor-box strong{font-size:14px}
    .autor-box span{font-size:13px;color:var(--cinza-600)}
    .feat-img{border-radius:14px;overflow:hidden;margin:18px 0;border:1px solid var(--cinza-200)}
    .feat-img figcaption{font-size:12px;color:var(--cinza-600);padding:8px 12px;background:var(--cinza-50);text-align:center}
    .faq{border:1px solid var(--cinza-200);border-radius:12px;overflow:hidden;margin:12px 0}
    .faq details{border-bottom:1px solid var(--cinza-200);padding:14px 16px;background:#fff}
    .faq details:last-child{border-bottom:0}
    .faq summary{font-weight:700;cursor:pointer;list-style:none}
    .faq summary::-webkit-details-marker{display:none}
    .aviso{background:#fff7ed;border:1px solid #fed7aa;color:#7c2d12;padding:12px 14px;border-radius:10px;font-size:13px;margin:16px 0}
    /* Footer */
    footer.site{margin-top:40px;background:#0b2e4a;color:#dbeafe;border-top:4px solid var(--amarelo)}
    footer.site a{color:#dbeafe}
    .footer-grid{display:grid;grid-template-columns:1fr;gap:22px;padding:28px 0}
    @media(min-width:760px){.footer-grid{grid-template-columns:1.4fr .8fr .8fr}}
    footer.site h4{margin:0 0 10px;color:#fff;font-size:14px;letter-spacing:.06em;text-transform:uppercase}
    footer.site p, footer.site li{font-size:14px;line-height:1.6;color:#cbd5e1}
    footer.site ul{list-style:none;padding:0;margin:0;display:grid;gap:6px}
    .copy{border-top:1px solid rgba(255,255,255,.12);padding:14px 0;font-size:12px;color:#93b4d4;display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px}
    /* Utilities */
    .section{padding:28px 0}
    .kicker{font-size:11px;letter-spacing:.14em;text-transform:uppercase;font-weight:800;color:var(--verde)}
    .discover-note{font-size:12px;color:var(--cinza-600);background:var(--cinza-50);border:1px dashed var(--cinza-200);padding:10px 12px;border-radius:8px}
    input,textarea{width:100%;padding:12px 14px;border:1px solid var(--cinza-200);border-radius:10px;font:inherit}
    input:focus,textarea:focus{outline:2px solid #bfdbfe;border-color:#60a5fa}
    label{font-weight:600;font-size:14px}
  </style>
</head>
<body>
  <div class="topbar">
    <div class="container">
      <span>🔎 Informação verificada • Fontes NASA, USP e BBC</span>
      <a href="/sobre">Quem escreve</a>
    </div>
  </div>

  <header class="site">
    <div class="container header-inner">
      <a href="/" class="brand" aria-label="Mundo Curioso Hoje - início">
        <span style="width:36px;height:36px;background:var(--azul);color:#fff;display:grid;place-items:center;border-radius:8px;font-size:18px">MC</span>
        <span>Mundo Curioso<small>HOJE • Ciência & Curiosidades</small></span>
      </a>
      <nav class="main" aria-label="Navegação principal">
        <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Início</a>
        <a href="/#curiosidades">Curiosidades</a>
        <a href="/sobre" aria-current={Astro.url.pathname === '/sobre' ? 'page' : undefined}>Sobre</a>
        <a href="/contato" aria-current={Astro.url.pathname === '/contato' ? 'page' : undefined}>Contato</a>
        <a href="/privacidade">Privacidade</a>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site">
    <div class="container footer-grid">
      <div>
        <div style="display:flex;gap:10px;align-items:center;margin-bottom:10px">
          <span style="width:36px;height:36px;background:#fff;color:var(--azul);display:grid;place-items:center;border-radius:8px;font-weight:800">MC</span>
          <strong style="color:#fff">Mundo Curioso Hoje</strong>
        </div>
        <p>Jornalismo de curiosidades sobre ciência, espaço, corpo humano e história. Histórias curtas com fontes primárias NASA, USP, BBC e Nature.</p>
        <p style="margin-top:10px"><span class="kicker" style="color:var(--amarelo)">E-E-A-T</span> — Conteúdo revisado por <a href="/sobre"><strong>Leo Mendes</strong></a>, Curador Científico (8 anos).</p>
      </div>
      <div>
        <h4>Institucional</h4>
        <ul>
          <li><a href="/sobre">Sobre nós &amp; Autoridade (E-E-A-T)</a></li>
          <li><a href="/contato">Contato / Fale conosco</a></li>
          <li><a href="/privacidade">Política de Privacidade (LGPD)</a></li>
          <li><a href="/termos">Termos de Uso</a></li>
        </ul>
      </div>
      <div>
        <h4>Transparência</h4>
        <ul>
          <li>Atualizado em: {new Date().toLocaleDateString('pt-BR')}</li>
          <li><a href="/sitemap-index.xml">Mapa do site</a></li>
          <li><a href="/robots.txt">robots.txt</a></li>
          <li style="color:#93b4d4;font-size:12px">Anúncios via Google AdSense • Analytics GA4</li>
        </ul>
      </div>
    </div>
    <div class="container copy">
      <span>© {new Date().getFullYear()} Mundo Curioso Hoje — Conteúdo informativo, não substitui orientação oficial.</span>
      <span>Feito com <span style="color:var(--amarelo)">Astro</span> • Hospedado na Netlify • Core Web Vitals otimizado</span>
    </div>
  </footer>
</body>
</html>
